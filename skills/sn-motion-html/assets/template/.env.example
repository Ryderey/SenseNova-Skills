# Optional local settings, loaded by scripts/agnes_video.py.
# Existing process variables win. Values are literal, without interpolation.
# Requires python-dotenv from sn-image-base/requirements.txt.
# Keep this file and .env private; never commit actual secrets.
#
# Video projects generated by this skill call Agnes Video through the sibling
# agnes-media skill, which reads AGNES_API_KEY. Set AGNES_BASE_URL only for a
# user-selected Agnes platform: .cn and .com keys are not interchangeable.
AGNES_API_KEY=
AGNES_BASE_URL=

# Image operations use the SenseNova backend and model selected by the pipeline.
SENSENOVA_API_KEY=

# Optional client locations; explicit --agnes-cli / --image-cli take precedence.
AGNES_SKILL_DIR=
SN_IMAGE_BASE_DIR=
