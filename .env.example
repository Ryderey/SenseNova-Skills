# Required for SenseNova image generation and editing.
# Keep the real value in an ignored local .env or your agent's secret store.
SN_API_KEY=

# Image defaults (shown explicitly for discoverability).
SN_IMAGE_GEN_BASE_URL=https://token.sensenova.cn/v1
SN_IMAGE_GEN_MODEL_TYPE=sensenova
SN_IMAGE_GEN_MODEL=sensenova-u1.5-lite
SN_IMAGE_GEN_FALLBACK_MODEL=sensenova-u1-fast

# Optional image-specific key override.
SN_IMAGE_GEN_API_KEY=

# Optional external text/vision adapters.
# Leave model names empty to let the host Agent plan and review.
SN_CHAT_API_KEY=
SN_CHAT_BASE_URL=https://token.sensenova.cn/v1
SN_CHAT_MODEL=
SN_TEXT_API_KEY=
SN_TEXT_BASE_URL=
SN_TEXT_MODEL=
SN_VISION_API_KEY=
SN_VISION_BASE_URL=
SN_VISION_MODEL=
