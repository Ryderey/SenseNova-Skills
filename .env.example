# Required for SenseNova image generation and editing.
# Keep the real value in an ignored local .env or your agent's secret store.
SENSENOVA_API_KEY=

# Optional global endpoint fallback for all SenseNova capabilities.
SN_BASE_URL=

# API key priority: CLI > direct capability key > SN_CHAT_API_KEY where applicable
# > SENSENOVA_API_KEY.
# Image defaults (shown explicitly for discoverability).
SN_IMAGE_GEN_BASE_URL=https://token.sensenova.cn/v1
SN_IMAGE_GEN_MODEL_TYPE=sensenova
SN_IMAGE_GEN_MODEL=sensenova-u1.6-lite
# Optional generation-only fallback. Empty by default: automatic fallback is off.
# sensenova-u1.5-fast / sensenova-u1-fast are retired and unsupported.
SN_IMAGE_GEN_FALLBACK_MODEL=

# Optional image-specific key override.
SN_IMAGE_GEN_API_KEY=

# Optional external text/vision adapters.
# Leave model names empty to let the host Agent plan and review.
SN_CHAT_API_KEY=
SN_CHAT_BASE_URL=https://token.sensenova.cn/v1
SN_CHAT_TYPE=openai-completions
SN_CHAT_MODEL=
SN_TEXT_API_KEY=
SN_TEXT_BASE_URL=
SN_TEXT_TYPE=
SN_TEXT_MODEL=
SN_VISION_API_KEY=
SN_VISION_BASE_URL=
SN_VISION_TYPE=
SN_VISION_MODEL=

# Set to 1 to disable automatic repository Release checks.
# Explicit --check-update / sn-check-update commands still run.
SN_SKILLS_NO_UPDATE_CHECK=0
